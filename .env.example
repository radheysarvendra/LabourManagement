PORT=5352
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SECRET_KEY=replace-with-a-long-random-secret
ENABLE_DB_SYNC=true

# Optional local backup/sync
LIVE_DATABASE_URL=postgresql://neondb_owner:YOUR_REAL_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/labour_db
BACKUP_DIR=backups
